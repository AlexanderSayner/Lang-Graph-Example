# ============== Query & Mutation Definitions ==============

type Query {
    listGraphs(pageSize: Int! = 10, pageToken: String): GraphListPayload!
    getGraphState(graphId: String!, threadId: String): GraphStatePayload!
}

type Mutation {
    buildGraph(input: BuildGraphInput!): BuildGraphPayload!
    executeGraph(input: ExecuteGraphInput!): ExecuteGraphPayload!
    updateGraphState(input: UpdateGraphStateInput!): UpdateGraphStatePayload!
    deleteGraph(graphId: String!): DeleteGraphPayload!
}

type Subscription {
    executeGraphStream(input: ExecuteGraphInput!): GraphExecutionEventPayload!
}

# ============== Input Types (Match your DTOs) ==============

input BuildGraphInput {
    graphId: String!
    graphName: String!
    nodes: [NodeInput!]!
    edges: [EdgeInput!]!
    config: JSON
}

input ExecuteGraphInput {
    graphId: String!
    input: String!
    context: JSON
}

input UpdateGraphStateInput {
    graphId: String!
    threadId: String
    stateUpdates: JSON!
}

input NodeInput {
    nodeId: String!
    nodeType: String!
    handlerName: String!
    metadata: JSON
}

input EdgeInput {
    source: String!
    target: String!
    condition: String
}

# ============== Output Payloads (Match Controller Return Types) ==============

type GraphListPayload {
    graphs: [GraphInfo!]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type GraphStatePayload {
    success: Boolean!
    state: JSON!
    currentNode: String
    nodeHistory: [String!]!
}

type BuildGraphPayload {
    success: Boolean!
    graphId: String
    message: String!
}

type ExecuteGraphPayload {
    success: Boolean!
    output: String
    state: JSON
    errorMessage: String
}

type UpdateGraphStatePayload {
    success: Boolean!
    updatedState: JSON!
    message: String!
}

type DeleteGraphPayload {
    success: Boolean!
    message: String!
}

type GraphExecutionEventPayload {
    eventType: String!
    nodeId: String
    output: String
    state: JSON
    timestamp: Long!
    errorMessage: String
}

# ============== Common Types ==============

type GraphInfo {
    graphId: ID!
    graphName: String!
    nodeCount: Int!
    createdAt: String!
    status: GraphStatus!
}

type PageInfo {
    hasNextPage: Boolean!
    endCursor: String
}

enum GraphStatus {
    ACTIVE
    INACTIVE
    ERROR
    BUILDING
}

# ============== Scalar Types ==============

"The `JSON` scalar type represents JSON values as specified by ECMA-404."
scalar JSON

"The `Long` scalar type represents a 64-bit signed integer."
scalar Long