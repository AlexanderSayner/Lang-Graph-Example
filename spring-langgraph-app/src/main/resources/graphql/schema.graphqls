# ============== Query & Mutation Definitions ==============

type Query {
    listGraphs(pageSize: Int! = 10, pageToken: String): GraphListPayload!
    getGraphState(graphId: String!, threadId: String): GraphStatePayload!
    getGraphView(graphId: String!): GraphViewPayload!
    getExecutionHistory(graphId: String!, threadId: String!): GraphHistoryPayload!
}

type Mutation {
    buildGraph(input: BuildGraphInput!): BuildGraphPayload!
    executeGraph(input: ExecuteGraphInput!): ExecuteGraphPayload!
    updateGraphState(input: UpdateGraphStateInput!): UpdateGraphStatePayload!
    deleteGraph(graphId: String!): DeleteGraphPayload!
    saveGraphCoordinates(graphId: String!, positions: [NodePositionInput!]!): GraphViewPayload!
}

type Subscription {
    executeGraphStream(input: ExecuteGraphInput!): GraphExecutionEventPayload!
}

# ============== Input Types (Match your DTOs) ==============

input BuildGraphInput {
    graphId: String!
    graphName: String!
    nodes: [NodeInput!]!
    edges: [EdgeInput!]!
    config: JSON
}

input ExecuteGraphInput {
    graphId: String!
    threadId: String
    input: String!
    context: JSON
}

input UpdateGraphStateInput {
    graphId: String!
    threadId: String
    stateUpdates: JSON!
}

input NodeInput {
    nodeId: String!
    nodeType: String!
    handlerName: String!
    metadata: JSON
}

input EdgeInput {
    source: String!
    target: String!
    condition: String
}

input NodePositionInput {
    nodeId: String!
    x: Float!
    y: Float!
}

# ============== Output Payloads (Match Controller Return Types) ==============

type GraphListPayload {
    graphs: [GraphInfo!]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type GraphStatePayload {
    success: Boolean!
    state: JSON!
    currentNode: String
    nodeHistory: [String!]!
}

type BuildGraphPayload {
    success: Boolean!
    graphId: String
    message: String!
}

type ExecuteGraphPayload {
    success: Boolean!
    output: String
    state: JSON
    errorMessage: String
}

type UpdateGraphStatePayload {
    success: Boolean!
    updatedState: JSON!
    message: String!
}

type DeleteGraphPayload {
    success: Boolean!
    message: String!
}

type GraphExecutionEventPayload {
    eventType: String!
    nodeId: String
    output: String
    state: JSON
    timestamp: Long!
    errorMessage: String
}

type GraphHistoryPayload {
    success: Boolean!
    history: [StateSnapshot!]!
    errorMessage: String
}

type StateSnapshot {
    nodeId: String!
    stateJson: JSON!
    timestamp: String!
}

# ============== Graph View Types (for visualization) ==============

type GraphViewPayload {
    success: Boolean!
    graphId: String
    graphName: String
    status: String
    nodes: [GraphNode!]!
    edges: [GraphEdge!]!
    message: String
}

type GraphNode {
    nodeId: String!
    nodeType: String!
    handlerName: String
    metadata: JSON
    position: Position
}

type GraphEdge {
    source: String!
    target: String!
    condition: String
    label: String
}

type Position {
    x: Float!
    y: Float!
}

# ============== Common Types ==============

type GraphInfo {
    graphId: ID!
    graphName: String!
    nodeCount: Int!
    createdAt: String!
    status: GraphStatus!
}

type PageInfo {
    hasNextPage: Boolean!
    endCursor: String
}

enum GraphStatus {
    ACTIVE
    INACTIVE
    ERROR
    BUILDING
}

# ============== Scalar Types ==============

"The `JSON` scalar type represents JSON values as specified by ECMA-404."
scalar JSON

"The `Long` scalar type represents a 64-bit signed integer."
scalar Long