directive @constraint(
    minLength: Int
    maxLength: Int
    min: Int
    max: Int
    pattern: String
) on INPUT_FIELD_DEFINITION | ARGUMENT_DEFINITION

type Query {
    "List all available graphs with pagination"
    listGraphs(
        pageSize: Int = 10 @constraint(min: 1, max: 100)
        pageToken: String
    ): GraphConnection!

    "Get the current state of a graph"
    getGraphState(
        graphId: String! @constraint(minLength: 1, maxLength: 100)
        threadId: String
    ): GraphState!
}

type Mutation {
    "Build a new graph with the given configuration"
    buildGraph(input: BuildGraphInput!): BuildGraphResult!

    "Execute a graph with the given input"
    executeGraph(input: ExecuteGraphInput!): ExecuteGraphResult!

    "Update the state of a graph"
    updateGraphState(input: UpdateGraphStateInput!): UpdateGraphStateResult!

    "Delete a graph"
    deleteGraph(graphId: String! @constraint(minLength: 1)): DeleteGraphResult!
}

type Subscription {
    "Subscribe to real-time graph execution events"
    executeGraphStream(input: ExecuteGraphInput!): ExecuteGraphEvent!
}

# ============== Input Types ==============

input BuildGraphInput {
    graphId: String! @constraint(minLength: 1, maxLength: 100)
    graphName: String! @constraint(minLength: 1, maxLength: 200)
    nodes: [NodeInput!]! @constraint(minSize: 1)
    edges: [EdgeInput!]!
    config: JSON
}

input ExecuteGraphInput {
    graphId: String! @constraint(minLength: 1)
    input: String! @constraint(minLength: 1)
    context: JSON
}

input UpdateGraphStateInput {
    graphId: String! @constraint(minLength: 1)
    threadId: String
    stateUpdates: JSON! @constraint(minSize: 1)
}

input NodeInput {
    nodeId: String! @constraint(minLength: 1, maxLength: 100)
    nodeType: String! @constraint(minLength: 1)
    handlerName: String! @constraint(minLength: 1)
    metadata: JSON
}

input EdgeInput {
    source: String! @constraint(minLength: 1)
    target: String! @constraint(minLength: 1)
    condition: String
}

# ============== Output Types ==============

type GraphConnection {
    graphs: [GraphInfo!]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type PageInfo {
    hasNextPage: Boolean!
    endCursor: String
}

type GraphInfo {
    graphId: ID!
    graphName: String!
    nodeCount: Int!
    createdAt: String!
    status: GraphStatus!
}

enum GraphStatus {
    ACTIVE
    INACTIVE
    ERROR
    BUILDING
}

type GraphState {
    success: Boolean!
    state: JSON!
    currentNode: String
    nodeHistory: [String!]!
}

type BuildGraphResult {
    success: Boolean!
    graphId: String
    message: String!
}

type ExecuteGraphResult {
    success: Boolean!
    output: String
    state: JSON
    errorMessage: String
}

type UpdateGraphStateResult {
    success: Boolean!
    updatedState: JSON!
    message: String!
}

type DeleteGraphResult {
    success: Boolean!
    message: String!
}

type ExecuteGraphEvent {
    eventType: GraphEventType!
    nodeId: String
    output: String
    state: JSON
    timestamp: Long!
    errorMessage: String
}

enum GraphEventType {
    START
    NODE_START
    NODE_END
    END
    ERROR
}

# ============== Scalar Types ==============

"The `JSON` scalar type represents JSON values as specified by ECMA-404."
scalar JSON

"The `Long` scalar type represents a 64-bit signed integer."
scalar Long
