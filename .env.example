# ---------------------------------------------------------------------------
# Personal LLM API keys (see README -> "Personal LLM API keys").
#
# Compose reads `.env` from the repository root. `.env` is git-ignored - keep it there, and
# keep a copy of LLM_SECRET_MASTER_KEY somewhere else as well: stored personal keys are
# encrypted with it and are unrecoverable without it.
# ---------------------------------------------------------------------------

# AES-256 master key for encrypting personal keys at rest:  openssl rand -base64 32
# Blank (or unset) = personal keys are disabled and everything runs on the shared service key.
LLM_SECRET_MASTER_KEY=

# FALLBACK (default) = a user with no personal key runs on the shared key, reported as
#                      llmBilling="service"
# REQUIRE             = a user with no key is refused instead of spending the operator's credits
# PERSONAL_ONLY       = REQUIRE, and anonymous GraphQL / B2B gRPC callers are refused too -
#                       pair it with LLM_SERVICE_KEY_ENABLED=false below
LLM_CREDENTIALS_POLICY=FALLBACK

# Shared-key kill switch for the Python engine (langgraph-service): false = it never reads
# YC_API_KEY / OPENAI_API_KEY / ... and refuses any LLM call without a personal user key.
LLM_SERVICE_KEY_ENABLED=true