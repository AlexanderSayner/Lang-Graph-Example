# ---------------------------------------------------------------------------
# Python LangGraph service - example environment
# Copy to `.env` and fill in the key(s) for the provider you actually use.
# Only the key of the *selected* provider is required.
# ---------------------------------------------------------------------------

# --- Server ---
SERVER_PORT=50051
MAX_WORKERS=10
MAX_MESSAGE_LENGTH=52428800
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6380
DATABASE_URL=postgresql://langgraph:langgraph_password@localhost:7432/langgraph_db
HTTP_REQUEST_SERVICE_HOST=localhost
HTTP_REQUEST_SERVICE_PORT=9090

# --- Default LLM (last fallback: node metadata > graph config > here) ---
# Provider: yandex | openai | groq | deepseek | openrouter | anthropic
LLM_PROVIDER=yandex
# Empty = use LLM_PROVIDER's default model. Applies to the DEFAULT provider only: a node or
# graph that selects a different provider uses that provider's own model setting (below) or
# its preset, so this value is never sent to a provider it does not belong to.
LLM_MODEL=
# Default sampling temperature. 0.6 preserves the pre-multi-provider YandexGPT behaviour.
LLM_TEMPERATURE=0.6
LLM_MAX_OUTPUT_TOKENS=2000
# Optional dedicated provider for the in-UI copilot (empty = LLM_PROVIDER above)
COPILOT_PROVIDER=
COPILOT_MODEL=

# --- YandexGPT (default provider) ---
YC_API_KEY=
YC_FOLDER_ID=
# YandexGPT model: yandexgpt | yandexgpt-lite (yandex's <PROVIDER>_MODEL override)
YC_MODEL_NAME=yandexgpt
YC_COMPLETION_MODE=sync

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Groq (OpenAI-compatible) ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- DeepSeek (OpenAI-compatible) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- OpenRouter (OpenAI-compatible) ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com
